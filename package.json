{
	"name": "obs-studio",
	"version": "4.0.0-beta.4",
	"main": "dist/main.js",
	"type": "module",
	"scripts": {
		"postinstall": "husky",
		"format": "prettier -w .",
		"format:check": "prettier --check .",
		"package": "run build && companion-module-build",
		"build": "rimraf dist && tsc -p tsconfig.build.json",
		"check": "run format:check && run lint && run check-types && run test",
		"check-types": "tsc -p tsconfig.json --noEmit",
		"dev": "tsc -p tsconfig.build.json --watch",
		"lint": "eslint .",
		"test": "vitest --run"
	},
	"license": "MIT",
	"dependencies": {
		"@companion-module/base": "~2.1.3",
		"obs-websocket-js": "5.0.8"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bitfocus/companion-module-obs-studio.git"
	},
	"devDependencies": {
		"@companion-module/tools": "^3.2.0",
		"@types/node": "^26.6.5",
		"@vitest/eslint-plugin": "^1.6.27",
		"eslint": "^10.12.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"prettier": "^3.9.10",
		"rimraf": "^6.1.3",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2",
		"vitest": "^4.1.11"
	},
	"engines": {
		"node": "26",
		"yarn": "^4"
	},
	"prettier": "@companion-module/tools/.prettierrc.json",
	"lint-staged": {
		"*.{css,json,md,scss}": [
			"prettier --write"
		],
		"*.{ts,tsx,js,jsx}": [
			"eslint --fix"
		]
	},
	"packageManager": "yarn@4.18.1"
}
